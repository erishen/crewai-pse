OPENAI_API_KEY=your-api-key
OPENAI_BASE_URL=https://api.example.com/v1
OPENAI_MODEL=your-model-name
# AGNES_KEY=your-agnes-key
# AGNES_BASE_URL=https://api.example.com/v1
PSE_MAX_RETRIES=3

# 项目文章输出目录（绝对路径）
ARTICLES_DIR=/path/to/articles/output

# 仓库根目录（projects.json 中 source_dir 的基准路径）
PSE_ROOT=/path/to/your/workspace

# wordpress-tools 目录（用于 --publish 发布到线上）
WP_TOOLS_DIR=/path/to/wordpress-tools

# WordPress API 配置（用于更新链接页面）
WP_API_URL=https://your-site.com/wp-json/wp/v2
WP_USERNAME=your-username
WP_APP_PASSWORD=your-app-password
LINKS_PAGE_ID=your-page-id

# 默认项目（make articles / publish / archive 可省略 P=）
DEFAULT_PROJECT=your-project-name
