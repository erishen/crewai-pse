OPENAI_API_KEY=your-api-key
OPENAI_BASE_URL=https://api.example.com/v1
OPENAI_MODEL=your-model-name
# 免费 gateway（与 DeepSeek 同 OpenAI 兼容协议）：可选，作为 make articles / translate 免费模式的凭证
# FREE_KEY=your-free-key
# FREE_BASE_URL=https://api.example.com/v1
PSE_MAX_RETRIES=3

# 项目文章输出目录（绝对路径）
ARTICLES_DIR=/path/to/articles/output

# 仓库根目录（projects.json 中 source_dir 的基准路径）
PSE_ROOT=/path/to/your/workspace

# wordpress-tools 目录（用于 --publish 发布到线上）
WP_TOOLS_DIR=/path/to/wordpress-tools

# WordPress API 配置（用于更新链接页面）
WP_API_URL=https://your-site.com/wp-json/wp/v2
WP_USERNAME=your-username
WP_APP_PASSWORD=your-app-password
LINKS_PAGE_ID=your-page-id

# 默认项目（make articles / publish / archive 可省略 P=）
DEFAULT_PROJECT=your-project-name

# ---- 翻译上游：本机 tsm-hub 网关（OpenAI 兼容，模型别名在网关侧 failover）----
# 网关地址固定为容器映射端口；正式实例见 work/golang/tsm-hub/docker-compose.yml
HUB_BASE_URL=http://127.0.0.1:19070/v1
# 翻译用的路由别名：chat（硅基流动 Qwen3-8B → openrouter 免费）或 tr-zh / deepseek-v4-flash
HUB_MODEL=chat
# 在 tsm-hub 管理台按「Keys」页面签发，形如 sk-tr-…（明文只显示一次）
HUB_KEY=sk-tr-your-hub-key
